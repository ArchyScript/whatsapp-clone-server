NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
GRAPHQL_PATH=/graphql
APP_ORIGIN=http://localhost:5173
APP_NAME=Messaging Platform

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_backend?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_backend?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50

UPLOAD_DRIVER=local
UPLOAD_MAX_FILE_SIZE_BYTES=26214400
UPLOAD_LOCAL_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

STUN_SERVERS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

LOG_LEVEL=info
